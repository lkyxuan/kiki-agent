#!/bin/bash
# Background service run by launchd: starts Kiki using the Node bundled in the app. Logs are in ~/Library/Logs/Kiki/server.log
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
export KIKI_APP="$(cd "$RES/../.." && pwd)"   # Tells Kiki where it is installed; needed for auto-update
export DATA_DIR="${DATA_DIR:-$HOME/Kiki}"
# Run the Node inside the "Kiki Agent" helper app directly: that's what macOS privacy permissions recognize (older versions don't have this helper app, so fall back to the original location)
NODE="$RES/../Helpers/KikiAgent.app/Contents/MacOS/kiki-node"
[ -x "$NODE" ] || NODE="$RES/node/bin/node"
MAIN="$RES/app/dist/main.js"
ENVF="$DATA_DIR/.env"
# Working directory is the data folder, where Kiki reads .env; on first launch the data folder doesn't exist yet, so stay in the home directory
cd "$DATA_DIR" 2>/dev/null || cd "$HOME"

# Resolve the key references in .env to real values before starting; start anyway if they can't be resolved (the background service must not hang, or auto-update will consider it failed):
#   KEY=keychain:<name>   Read from the macOS Keychain (recommended: available after login, no repeated authorization)
#   KEY=op://…            Read from 1Password (wait up to 20 seconds; the background service often can't get authorization, see docs/mac-app.md)
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}
op_read() {
  command -v op >/dev/null 2>&1 || return 0
  local out pid timer
  out=$(mktemp)
  op read "$1" >"$out" 2>/dev/null &
  pid=$!
  # The watchdog's output must be discarded, otherwise its sleep holds the $( ) pipe open and we'd wait the full 20 seconds even on success
  ( sleep 20; kill "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
  timer=$!
  wait "$pid" 2>/dev/null
  kill "$timer" 2>/dev/null
  pkill -P "$timer" 2>/dev/null
  cat "$out"
  rm -f "$out"
}
if [ -f "$ENVF" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    val="${line#*=}"
    # Match Node's .env parsing: strip the export prefix, surrounding whitespace, and quotes; strip trailing # comments when unquoted
    key="${key#export }"
    key="$(trim "$key")"
    val="$(trim "$val")"
    case "$val" in
      \"*\"|\'*\') val="${val:1:${#val}-2}" ;;
      *) val="$(trim "${val%%[[:space:]]#*}")" ;;
    esac
    case "$val" in
      keychain:*) v=$(security find-generic-password -s "${val#keychain:}" -w 2>/dev/null) ;;
      op://*) v=$(op_read "$val") ;;
      *) continue ;;
    esac
    [ -n "$v" ] || echo "[$(date '+%F %T')] Could not resolve ${key} (${val}); starting without it"
    export "$key=$v"   # Set it to empty even if unresolved, so Kiki doesn't treat the reference text as the key
  done < "$ENVF"
fi
exec "$NODE" "$MAIN"
