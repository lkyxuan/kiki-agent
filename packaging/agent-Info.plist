<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kiki Agent (Contents/Helpers/KikiAgent.app): wraps the Node process that does the real work in a small app.
     This way System Settings > Privacy & Security shows "Kiki Agent" with Kiki's icon instead of a program called node;
     developer signing + a fixed identifier (com.lkyxuan.kiki.en.agent) means permissions already granted survive auto-updates and don't need to be granted again. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Kiki Agent</string>
  <key>CFBundleDisplayName</key><string>Kiki Agent</string>
  <key>CFBundleIdentifier</key><string>com.lkyxuan.kiki.en.agent</string>
  <key>CFBundleExecutable</key><string>kiki-node</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__VERSION__</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>LSUIElement</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Kiki needs to operate apps like Calendar, Notes, Reminders, Contacts, and Finder on your behalf.</string>
  <key>NSCalendarsUsageDescription</key><string>Kiki needs to see your schedule and help you create meetings.</string>
  <key>NSCalendarsFullAccessUsageDescription</key><string>Kiki needs to see your schedule and help you create meetings.</string>
  <key>NSRemindersUsageDescription</key><string>Kiki needs to see and add your to-dos.</string>
  <key>NSRemindersFullAccessUsageDescription</key><string>Kiki needs to see and add your to-dos.</string>
  <key>NSContactsUsageDescription</key><string>Kiki needs to identify who sent your messages and emails.</string>
  <key>NSPhotoLibraryUsageDescription</key><string>Kiki needs to find photos and organize your library when you ask.</string>
  <key>NSMicrophoneUsageDescription</key><string>Kiki needs to hear you (voice input).</string>
  <key>NSCameraUsageDescription</key><string>Kiki needs to take photos or scan codes when you need it to.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Kiki needs to connect to another computer on your Tailscale or local network.</string>
</dict>
</plist>
