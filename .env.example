# Model: pi built-in DeepSeek
DEEPSEEK_API_KEY=
MODEL=deepseek/deepseek-flash

# Where your data goes (About me, each agent's instructions and conversation history)
DATA_DIR=~/Kiki
# Which agent the main bot falls back to when it gets a regular message and no conversation has been selected
DEFAULT_AGENT=Kiki
# Web port: http://localhost:4567
PORT=4567

# How often the Mailroom checks in with external agents (seconds), default 60. For the mailbox format see data folder/postroom/mailbox/README.md
# POSTROOM_POLL_SEC=60
